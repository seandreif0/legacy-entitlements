<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:jdbc="http://www.springframework.org/schema/jdbc"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
         http://www.springframework.org/schema/jdbc http://www.springframework.org/schema/jdbc/spring-jdbc-3.2.xsd">

  <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
    <property name="driverClassName" value="${ent.jdbc.driver}"/>
    <property name="url" value="${ent.jdbc.url}"/>
    <property name="username" value="${ent.jdbc.user}"/>
    <property name="password" value="${ent.jdbc.password}"/>
    <property name="maxActive" value="8"/>
    <property name="defaultAutoCommit" value="true"/>
  </bean>

  <!-- local only. DBA owns the real schema -->
  <jdbc:initialize-database data-source="dataSource">
    <jdbc:script location="classpath:sql/schema.sql"/>
    <jdbc:script location="classpath:sql/seed.sql"/>
  </jdbc:initialize-database>

  <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
    <property name="dataSource" ref="dataSource"/>
  </bean>

  <bean id="userDao" class="com.meridian.ent.dao.OracleUserDao">
    <property name="jdbcTemplate" ref="jdbcTemplate"/>
  </bean>
  <bean id="entitlementDao" class="com.meridian.ent.dao.OracleEntitlementDao">
    <property name="jdbcTemplate" ref="jdbcTemplate"/>
  </bean>
  <bean id="batchAuditDao" class="com.meridian.ent.dao.OracleBatchAuditDao">
    <property name="jdbcTemplate" ref="jdbcTemplate"/>
  </bean>
</beans>
