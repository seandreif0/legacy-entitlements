<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
         http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-3.2.xsd">

  <context:property-placeholder location="classpath:ent.properties" properties-ref="testOverrides" local-override="true"/>

  <bean id="testOverrides" class="org.springframework.beans.factory.config.PropertiesFactoryBean">
    <property name="properties">
      <props>
        <prop key="ent.jdbc.url">jdbc:h2:mem:enttest;MODE=Oracle;DB_CLOSE_DELAY=-1</prop>
        <prop key="ent.extract.dir">target/test-classes/extracts</prop>
      </props>
    </property>
  </bean>

  <import resource="classpath:entitlements-dao.xml"/>
  <import resource="classpath:entitlements-batch.xml"/>

  <bean id="entitlementService" class="com.meridian.ent.service.EntitlementServiceImpl">
    <property name="entitlementDao" ref="entitlementDao"/>
    <property name="userDao" ref="userDao"/>
  </bean>
</beans>
